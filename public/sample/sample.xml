	<ItemDef OID="record_id" Name="record_id" DataType="text" Length="999" redcap:Variable="record_id" redcap:FieldType="text">
		<Question><TranslatedText>Record ID</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="first_name" Name="first_name" DataType="text" Length="999" redcap:Variable="first_name" redcap:FieldType="text">
		<Question><TranslatedText>First name</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="dob" Name="dob" DataType="date" Length="999" redcap:Variable="dob" redcap:FieldType="text" redcap:TextValidationType="date_ymd">
		<Question><TranslatedText>Date of birth</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sex" Name="sex" DataType="text" Length="1" redcap:Variable="sex" redcap:FieldType="radio">
		<Question><TranslatedText>Sex</TranslatedText></Question>
		<CodeListRef CodeListOID="sex.choices"/>
	</ItemDef>
	<ItemDef OID="pregnant" Name="pregnant" DataType="boolean" Length="1" redcap:Variable="pregnant" redcap:FieldType="yesno" redcap:BranchingLogic="[sex] = &quot;2&quot; and [age] &gt;= 12 and [age] &lt;= 55">
		<Question><TranslatedText>Is the participant pregnant?</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="consent" Name="consent" DataType="boolean" Length="1" redcap:Variable="consent" redcap:FieldType="yesno" redcap:BranchingLogic="[age] &gt;= 18" redcap:FieldAnnotation="@DEFAULT='1'">
		<Question><TranslatedText>Adult consent obtained?</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="notes" Name="notes" DataType="text" Length="999" redcap:Variable="notes" redcap:FieldType="notes">
		<Question><TranslatedText>Notes for [first_name]</TranslatedText></Question>
	</ItemDef>

	<ItemDef OID="visit_date" Name="visit_date" DataType="date" Length="999" redcap:Variable="visit_date" redcap:FieldType="text" redcap:TextValidationType="date_ymd" redcap:FieldAnnotation="@TODAY">
		<Question><TranslatedText>Visit date</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="age" Name="age" DataType="integer" Length="999" redcap:Variable="age" redcap:FieldType="calc" redcap:Calculation="rounddown(datediff([dob], [visit_date], &quot;y&quot;, true))">
		<Question><TranslatedText>Age (years)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="height_cm" Name="height_cm" DataType="float" Length="999" redcap:Variable="height_cm" redcap:FieldType="text">
		<Question><TranslatedText>Height (cm)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="weight_kg" Name="weight_kg" DataType="float" Length="999" redcap:Variable="weight_kg" redcap:FieldType="text">
		<Question><TranslatedText>Weight (kg)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="bmi" Name="bmi" DataType="float" Length="999" redcap:Variable="bmi" redcap:FieldType="calc" redcap:Calculation="round([weight_kg] / (([height_cm]/100)*([height_cm]/100)), 1)">
		<Question><TranslatedText>BMI</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="bmi_cat" Name="bmi_cat" DataType="text" Length="999" redcap:Variable="bmi_cat" redcap:FieldType="text" redcap:FieldAnnotation="@CALCTEXT(if([bmi] &gt;= 30, 'Obese', if([bmi] &gt;= 25, 'Overweight', 'Healthy')))">
		<Question><TranslatedText>BMI category</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="smoker" Name="smoker" DataType="boolean" Length="1" redcap:Variable="smoker" redcap:FieldType="yesno" redcap:BranchingLogic="[age] &gt;= 16">
		<Question><TranslatedText>Current or former smoker?</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="pack_years" Name="pack_years" DataType="float" Length="999" redcap:Variable="pack_years" redcap:FieldType="text" redcap:BranchingLogic="[smoker] = '1' and [consent] = '1'">
		<Question><TranslatedText>Pack-years</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="symptoms" Name="symptoms" DataType="text" Length="1" redcap:Variable="symptoms" redcap:FieldType="checkbox">
		<Question><TranslatedText>Symptoms reported</TranslatedText></Question>
		<CodeListRef CodeListOID="symptoms.choices"/>
	</ItemDef>
	<ItemDef OID="symptom_other" Name="symptom_other" DataType="text" Length="999" redcap:Variable="symptom_other" redcap:FieldType="text" redcap:BranchingLogic="[symptoms(99)] = '1'">
		<Question><TranslatedText>Specify other symptom</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="risk_a" Name="risk_a" DataType="text" Length="999" redcap:Variable="risk_a" redcap:FieldType="text" redcap:BranchingLogic="[risk_b] = '1'">
		<Question><TranslatedText>Risk A (deliberate circular branching demo)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="risk_b" Name="risk_b" DataType="text" Length="999" redcap:Variable="risk_b" redcap:FieldType="text" redcap:BranchingLogic="[risk_a] = '1' and [smoking_status] = '1'">
		<Question><TranslatedText>Risk B (references undefined field smoking_status)</TranslatedText></Question>
	</ItemDef>

	<ItemDef OID="fu_date" Name="fu_date" DataType="date" Length="999" redcap:Variable="fu_date" redcap:FieldType="text" redcap:TextValidationType="date_ymd">
		<Question><TranslatedText>Follow-up date</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="fu_weight" Name="fu_weight" DataType="float" Length="999" redcap:Variable="fu_weight" redcap:FieldType="text">
		<Question><TranslatedText>Follow-up weight (kg); baseline was [weight_kg] kg</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="weight_change" Name="weight_change" DataType="float" Length="999" redcap:Variable="weight_change" redcap:FieldType="calc" redcap:Calculation="[fu_weight] - [baseline_arm_1][weight_kg]">
		<Question><TranslatedText>Weight change (kg)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="fu_summary" Name="fu_summary" DataType="text" Length="999" redcap:Variable="fu_summary" redcap:FieldType="descriptive">
		<Question><TranslatedText>Summary: BMI was [bmi] at baseline; change is [weight_change] kg.</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="fu_complications" Name="fu_complications" DataType="boolean" Length="1" redcap:Variable="fu_complications" redcap:FieldType="yesno" redcap:BranchingLogic="[weight_change] &lt; -5 or [symptoms(1)] = '1'">
		<Question><TranslatedText>Any complications?</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="fu_details" Name="fu_details" DataType="text" Length="999" redcap:Variable="fu_details" redcap:FieldType="notes" redcap:BranchingLogic="[fu_complications] = '1'">
		<Question><TranslatedText>Describe complications</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="fu_trend" Name="fu_trend" DataType="float" Length="999" redcap:Variable="fu_trend" redcap:FieldType="calc" redcap:BranchingLogic="[event-name] = 'followup_arm_1'" redcap:Calculation="[fu_weight] - [fu_weight][previous-instance]">
		<Question><TranslatedText>Weight change since previous follow-up (repeating event, smart variables)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="partner_note" Name="partner_note" DataType="text" Length="999" redcap:Variable="partner_note" redcap:FieldType="text" redcap:BranchingLogic="[enrol_arm_2][consent] = '1'">
		<Question><TranslatedText>Partner note (cross-arm reference)</TranslatedText></Question>
	</ItemDef>

	<ItemDef OID="sc_intro" Name="sc_intro" DataType="text" Length="999" redcap:Variable="sc_intro" redcap:FieldType="descriptive" redcap:BranchingLogic="[demographics_complete] = '2'" redcap:SectionHeader="Screening for [first_name] (born [dob])">
		<Question><TranslatedText>Hello [user-fullname] ([user-role-label]). Record [record-name], event [event-label]. Sex code [sex:value], photo [sc_sig:inline]. Queue: [survey-queue-url]</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_date" Name="sc_date" DataType="datetime" Length="999" redcap:Variable="sc_date" redcap:FieldType="text" redcap:TextValidationType="datetime_dmy" redcap:FieldAnnotation="@TODAY-SERVER" redcap:RequiredField="y" redcap:Identifier="y">
		<Question><TranslatedText>Screening date and time</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_dts" Name="sc_dts" DataType="partialDatetime" Length="999" redcap:Variable="sc_dts" redcap:FieldType="text" redcap:TextValidationType="datetime_seconds_dmy">
		<Question><TranslatedText>Timestamp with seconds</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_dmy" Name="sc_dmy" DataType="date" Length="999" redcap:Variable="sc_dmy" redcap:FieldType="text" redcap:TextValidationType="date_dmy" redcap:FieldAnnotation="@CALCDATE([dob], 18, 'y')">
		<Question><TranslatedText>Eighteenth birthday</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_time" Name="sc_time" DataType="partialTime" Length="999" redcap:Variable="sc_time" redcap:FieldType="text" redcap:TextValidationType="time">
		<Question><TranslatedText>Time of day</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_email" Name="sc_email" DataType="text" Length="999" redcap:Variable="sc_email" redcap:FieldType="text" redcap:TextValidationType="email" redcap:FieldAnnotation="@PLACEHOLDER='name@example.org' @CHARLIMIT=80" redcap:FieldNote="Contact for [first_name]" redcap:RequiredField="y" redcap:Identifier="y">
		<Question><TranslatedText>Contact email</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_sig" Name="sc_sig" DataType="text" Length="999" redcap:Variable="sc_sig" redcap:FieldType="file" redcap:TextValidationType="signature" redcap:FieldAnnotation="@HIDEBUTTON">
		<Question><TranslatedText>Signature</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_upload" Name="sc_upload" DataType="text" Length="999" redcap:Variable="sc_upload" redcap:FieldType="file" redcap:FieldAnnotation="@HIDE-BUTTON">
		<Question><TranslatedText>Supporting document</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_int" Name="sc_int" DataType="integer" Length="999" redcap:Variable="sc_int" redcap:FieldType="text" redcap:TextValidationType="int">
		<Question><TranslatedText>Whole number</TranslatedText></Question>
		<RangeCheck Comparator="GE" SoftHard="Soft"><CheckValue>0</CheckValue><ErrorMessage><TranslatedText>Should be 0 or more</TranslatedText></ErrorMessage></RangeCheck>
	</ItemDef>
	<ItemDef OID="sc_float" Name="sc_float" DataType="float" Length="999" redcap:Variable="sc_float" redcap:FieldType="text" redcap:TextValidationType="float">
		<Question><TranslatedText>Decimal number</TranslatedText></Question>
		<RangeCheck Comparator="LE" SoftHard="Hard"><CheckValue>300</CheckValue><ErrorMessage><TranslatedText>Must be 300 or less</TranslatedText></ErrorMessage></RangeCheck>
	</ItemDef>
	<ItemDef OID="sc_num" Name="sc_num" DataType="float" Length="999" redcap:Variable="sc_num" redcap:FieldType="text" redcap:TextValidationType="number">
		<Question><TranslatedText>Number</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_num1" Name="sc_num1" DataType="float" Length="999" redcap:Variable="sc_num1" redcap:FieldType="text" redcap:TextValidationType="number_1dp" redcap:SignificantDigits="1">
		<Question><TranslatedText>Number (1dp)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_num2" Name="sc_num2" DataType="float" Length="999" redcap:Variable="sc_num2" redcap:FieldType="text" redcap:TextValidationType="number_2dp">
		<Question><TranslatedText>Number (2dp)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_score" Name="sc_score" DataType="integer" Length="999" redcap:Variable="sc_score" redcap:FieldType="slider" redcap:BranchingLogic="[sex] &lt;&gt; '1'&#10;and [sc_int] != ''&#10;and [age] &gt;= 18" redcap:SliderLabels="Low|Medium|High">
		<Question><TranslatedText>Score</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_total" Name="sc_total" DataType="float" Length="999" redcap:Variable="sc_total" redcap:FieldType="calc" redcap:Calculation="sum([sc_int], [sc_float], abs([weight_change]))">
		<Question><TranslatedText>Total</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_mean" Name="sc_mean" DataType="float" Length="999" redcap:Variable="sc_mean" redcap:FieldType="calc" redcap:Calculation="mean([sc_int], [sc_num], max([sc_num1], [sc_num2]))">
		<Question><TranslatedText>Mean</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_code" Name="sc_code" DataType="text" Length="999" redcap:Variable="sc_code" redcap:FieldType="calc" redcap:Calculation="concat(left([first_name], 1), mid([first_name], 2, 3), right([record_id], 2), trim([sc_email]))">
		<Question><TranslatedText>Code</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_flag" Name="sc_flag" DataType="integer" Length="999" redcap:Variable="sc_flag" redcap:FieldType="calc" redcap:Calculation="if(contains([sc_comments], 'x') or length([sc_email]) &gt; 5, roundup([sc_float]), 0)">
		<Question><TranslatedText>Flag</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_cur" Name="sc_cur" DataType="float" Length="999" redcap:Variable="sc_cur" redcap:FieldType="calc" redcap:Calculation="[fu_weight][current-instance] - [sc_float] + [ghost_calc]">
		<Question><TranslatedText>Current instance minus decimal (repeating)</TranslatedText></Question>
	</ItemDef>
	<ItemDef OID="sc_pain" Name="sc_pain" DataType="text" Length="999" redcap:Variable="sc_pain" redcap:FieldType="select" redcap:FieldAnnotation="@HIDECHOICE='3'" redcap:SectionHeader="Pain for [first_name]" redcap:CustomAlignment="RH" redcap:MatrixGroupName="pain_grid">
		<Question><TranslatedText>Pain</TranslatedText></Question>
